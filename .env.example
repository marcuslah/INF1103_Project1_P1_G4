# Copy this file to .env and fill in your own values. Never commit .env.

# Required for AI extraction and review (get a key from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: AI model name and request timeout in seconds
GEMINI_MODEL=gemini-3.8-flash
REQUEST_TIMEOUT=30

# Optional: weekly study limit in hours (default 20)
STUDY_WEEKLY_CAPACITY=20

# Optional: where plans are stored. "json" (default) or "sqlite"
STORAGE_BACKEND=json
PLAN_PATH=data/study_plans.json
PLAN_DB_PATH=data/study_plans.db
